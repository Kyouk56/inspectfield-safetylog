# ==============================================================================
# InspectField SafetyLog - Custom Release Signing Keystore Configuration
# ==============================================================================
# By default, InspectField SafetyLog automatically signs release builds with the
# bundled production release keystore (app/keystore/safetylog-release.jks).
#
# To use your own private company keystore or Play Console upload key, copy this
# file to `keystore.properties` (or set environment variables) with your values:
#
# SAFETYLOG_KEYSTORE_FILE=/path/to/your/upload-keystore.jks
# SAFETYLOG_KEYSTORE_PASSWORD=your_keystore_password
# SAFETYLOG_KEY_ALIAS=your_key_alias
# SAFETYLOG_KEY_PASSWORD=your_key_password
